BACKUP ~weidu_external/backup/RedWizardKIT~
AUTHOR ~Sauler89 / RedWizard KIT; original Red Wizard by The Artisan~
VERSION ~v0.1.0-alpha5~

ALWAYS
  INCLUDE ~RedWizardKIT/lib/a7#add_kit_ex.tpa~
END

LANGUAGE ~English~ ~english~ ~RedWizardKIT/tra/english/setup.tra~
LANGUAGE ~Italiano~ ~italian~ ~RedWizardKIT/tra/italian/setup.tra~

BEGIN @4 DESIGNATED 0
GROUP ~RedWizard KIT~
REQUIRE_PREDICATE (GAME_IS ~BGEE BG2EE EET~) @6
FORBID_COMPONENT ~Setup-ArtisansKitpack_npc.tp2~ ~5102~ @7

COPY ~RedWizardKIT/2da/S9REDWIZ.2da~ ~override~
COPY ~RedWizardKIT/spells/S9RWBASE.SPL~ ~override~
COPY ~RedWizardKIT/spells/S9RWAUR.EFF~ ~override~
COPY ~RedWizardKIT/spells/S9RWAUR.SPL~ ~override~
COPY ~RedWizardKIT/spells/S9RWDEF.SPL~ ~override~
COPY ~RedWizardKIT/spells/S9RWPWR.SPL~ ~override~
COPY ~RedWizardKIT/spells/S9RWSLOT.SPL~ ~override~

ADD_PROJECTILE ~RedWizardKIT/spells/S9INAREL.PRO~ ~S9 Instant Area Enemies Large~

COPY_EXISTING ~S9RWAUR.SPL~ ~override~
  LPF ALTER_SPELL_HEADER
    INT_VAR
      projectile = S9INAREL
  END
BUT_ONLY

LAF ADD_KIT_EX
  INT_VAR
    kit_class = 1
    visible = 1
    mixed = RESOLVE_STR_REF(@0)
    lower = RESOLVE_STR_REF(@1)
    help = RESOLVE_STR_REF(@2)
    briefdesc = RESOLVE_STR_REF(@3)
  STR_VAR
    kit_name = ~S9REDWIZ~
    // Conjurer only. The original 0x00001080 also included the Necromancer
    // flag, which imposed Illusion as Edwin's additional prohibited school.
    unusable = ~0x00000080~
    alignmnt = ~0 1 1 0 1 1 0 1 1~
    clab_path = ~override/S9REDWIZ.2da~
  RET
    kit_id
END

BEGIN @5 DESIGNATED 100
GROUP ~RedWizard KIT~
REQUIRE_PREDICATE (GAME_IS ~BGEE BG2EE EET~) @6
REQUIRE_COMPONENT ~Setup-RedWizardKIT.tp2~ ~0~ @8
FORBID_COMPONENT ~Setup-ArtisansKitpack_npc.tp2~ ~5102~ @7

ACTION_FOR_EACH edwin IN edwin edwin2 edwin4 edwin6 edwin7 edwin9 edwin11 edwin12 edwin13 edwin15 BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%edwin%.cre~ BEGIN
    COPY_EXISTING ~%edwin%.cre~ ~override~
      WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~S9REDWIZ~))
    BUT_ONLY
  END
END

// The original Artisan component replaced MISC89.ITM with a custom 546-byte
// amulet containing nine opcode 42 effects (+1 wizard slot for levels 1-9).
// RedWizard KIT moves that class benefit into S9RWSLOT.SPL instead, so Edwin's
// currently installed amulet must remain completely untouched.
//
// Intentionally DO NOT remove Edwin's Illusion spells and DO NOT strip
// AddSpecialAbility("SPWI212") from EDWIN.BCS. Illusion is no longer an
// additional prohibited school in this version.

PRINT @9

// Component 100 patches game CRE resources. For reliable Edwin testing,
// use a new game or a save made before Edwin was instantiated/recruited.
